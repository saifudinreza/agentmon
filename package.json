{
  "name": "agentmon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r --if-present build",
    "check:size": "pnpm --filter @agentmon/web check:size",
    "check:secrets": "node tools/check-no-secrets.mjs",
    "e2e:register": "pnpm --filter @agentmon/server exec tsx ../../tools/e2e-register.mts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:size && pnpm check:secrets"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
